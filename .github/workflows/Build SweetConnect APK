
name: Build SweetConnect APK

'on':
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Inspect project ZIP
        run: |
          set -eu
          echo "Files in repository:"
          find . -maxdepth 4 -type f | sort
          ZIP=$(find . -maxdepth 3 -type f -name 'SweetConnectAndroid-project.zip' | head -1)
          if [ -z "$ZIP" ]; then
            echo "Project ZIP not found"
            exit 1
          fi
          mkdir extracted
          unzip -o "$ZIP" -d extracted
          echo "Gradle settings files:"
          find extracted -name settings.gradle -o -name settings.gradle.kts
          echo "Gradle build files:"
          find extracted -name build.gradle -o -name build.gradle.kts

      - name: Build APK
        run: |
          set -eu
          PROJECT_DIR=$(find extracted -name settings.gradle -printf '%h\n' | head -1)
          if [ -z "$PROJECT_DIR" ]; then
            PROJECT_DIR=$(find extracted -name settings.gradle.kts -printf '%h\n' | head -1)
          fi
          if [ -z "$PROJECT_DIR" ]; then
            echo "Could not find settings.gradle in ZIP"
            exit 1
          fi
          cd "$PROJECT_DIR"
          gradle assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: SweetConnect-APK
          path: extracted/**/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
